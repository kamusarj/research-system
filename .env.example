# Sao chép thành .env cho Docker Compose cục bộ. Điền khóa thật trong .env.
# Tùy chọn nâng cao nằm trong README.md và docker-compose.yml. Triển khai nhóm dùng .env.team.example.

# Đăng nhập cục bộ. Tạo chủ sở hữu bằng make local-owner.
AUTH_MODE=local

# Cổng máy chủ. Nếu đổi cổng giao diện, đổi API_CORS_ORIGINS tương ứng.
API_PORT=8000
FRONTEND_PORT=3000
API_CORS_ORIGINS=http://localhost:3000
# Chỉ cần điền khi dùng thêm tên miền tin cậy, ví dụ tên miền của tunnel.
API_TRUSTED_HOSTS=

# Giới hạn kết nối PostgreSQL cho cấu hình cục bộ.
API_WORKERS=4
DATABASE_POOL_SIZE=4
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=15

# Nhà cung cấp AI. Chỉ điền khóa của nhà cung cấp dùng cho tác vụ, chat hoặc embedding.
AI_PROVIDER=mistral
GRAPH_CHAT_DEFAULT_PROVIDER=deepseek
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Claude Code, Codex hoặc Antigravity. Script cài đặt ghi URL và token vào .env.
# Xem scripts/install_ai_cli_bridge.sh và mục cầu nối CLI trong README.md.
AI_CLI_BRIDGE_URL=
AI_CLI_BRIDGE_TOKEN=

# Model cục bộ qua hồ sơ local-ai. Chọn tên model đã cài và điền key nếu máy chủ yêu cầu.
OLLAMA_BASE_URL=http://172.17.0.1:11435
OLLAMA_MODEL=llama3.2
OLLAMA_API_KEY=
LOCAL_OPENAI_BASE_URL=http://172.17.0.1:11437/v1
LOCAL_OPENAI_MODEL=
LOCAL_OPENAI_API_KEY=

# Nghiên cứu sâu qua hồ sơ research-agent. Tạo SEARXNG_SECRET bằng openssl rand -hex 32.
RESEARCH_AGENT_ENABLED=false
RESEARCH_AGENT_PROVIDER=
SEARXNG_SECRET=

# Kết nối gói ChatGPT của từng người dùng. Tạo khóa qua app.operations generate-fernet-key.
CHATGPT_PLAN_ENABLED=false
CREDENTIALS_ENCRYPTION_KEY=

# Chỉ cần khi chọn kho tệp MinIO. Xem mục kho đối tượng trong README.md.
MINIO_ENDPOINT=minio.example.internal:9000

# Discord qua hồ sơ discord. Token API phải thuộc tài khoản dịch vụ cho bộ tiếp nhận.
DISCORD_BOT_TOKEN=
DISCORD_RESEARCH_API_TOKEN=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
