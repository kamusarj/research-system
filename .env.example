DATABASE_URL=postgresql+psycopg://research:research@database:5432/research
DATABASE_POOL_SIZE=4
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=15
DATABASE_POOL_RECYCLE_SECONDS=1800
API_WORKERS=4
DEPLOYMENT_ENVIRONMENT=local
SECRET_FILES_DIR=/run/secrets
API_CORS_ORIGINS=http://localhost:3000
# Host tin cậy thêm (ngoài localhost, tên dịch vụ nội bộ và host của API_CORS_ORIGINS) để chặn DNS
# rebinding; request thay đổi dữ liệu từ trang khác luôn bị chặn.
API_TRUSTED_HOSTS=
AI_PROVIDER=mistral
OLLAMA_BASE_URL=http://172.17.0.1:11435
OLLAMA_MODEL=llama3.2
OLLAMA_BRIDGE_UPSTREAM=http://127.0.0.1:11434
OLLAMA_BRIDGE_BIND=172.17.0.1
OLLAMA_BRIDGE_PORT=11435
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GRAPH_CHAT_DEFAULT_PROVIDER=deepseek
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_MAX_CONTEXT_CHARS=16000
CHAT_MAX_TOOL_LOOPS=4
CHAT_MAX_PROPOSALS=20
CHAT_MAX_MESSAGE_CHARS=12000
CHAT_MAX_OUTPUT_TOKENS=1500
CHAT_IMPORT_MAX_HTML_BYTES=2000000
CHAT_IMPORT_MAX_MESSAGES=400
CHAT_IMPORT_MAX_IMAGES=50
CHAT_IMPORT_MAX_IMAGE_BYTES=10000000
CHAT_IMPORT_MAX_TOTAL_IMAGE_BYTES=50000000
CHAT_IMPORT_MAX_TOTAL_CHARS=400000
CHAT_IMPORT_TIMEOUT_SECONDS=20
CHAT_IMPORT_MAX_REDIRECTS=2
CHAT_IMPORT_IMAGE_RETRIES=2
CHAT_IMPORT_IMAGE_RETRY_BACKOFF_SECONDS=0.25
CHAT_REDACTION_ENABLED=true
GRAPH_V2_ENABLED=true
GRAPH_V2_DOCUMENTS_ENABLED=true
GRAPH_V2_CHAT_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_UPLOADS_PER_WINDOW=10
RATE_LIMIT_ANALYSIS_PER_WINDOW=10
RATE_LIMIT_CHAT_PER_WINDOW=30
RATE_LIMIT_APPLY_PER_WINDOW=10
API_SLOW_REQUEST_MS=2000
HTTP_GZIP_MINIMUM_SIZE=1024
HTTP_GZIP_COMPRESSLEVEL=5
LOG_FORMAT=json
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
# Bắt buộc đăng nhập (khuyến nghị). Tạo chủ sở hữu: make local-owner NAME="Họ tên" EMAIL=ten@example.com
# `disabled` chỉ dành cho máy phát triển một người, không bao giờ khi mở tunnel/LAN.
AUTH_MODE=local
AUTH_SESSION_HOURS=12
AUTH_COOKIE_NAME=research_session
AUTH_CSRF_COOKIE_NAME=research_csrf
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_LOGIN_ATTEMPTS_PER_WINDOW=5
API_PROXY_TIMEOUT_MS=180000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Dùng quota Claude Code/Codex/Antigravity đã đăng nhập trên máy thay cho API (chỉ chế độ
# cục bộ một chủ máy). Chạy `scripts/install_ai_cli_bridge.sh`, rồi đặt AI_PROVIDER và
# GRAPH_CHAT_DEFAULT_PROVIDER thành claude_code, codex hoặc antigravity. Embedding vẫn dùng Mistral.
AI_CLI_BRIDGE_URL=
AI_CLI_BRIDGE_TOKEN=
AI_CLI_TIMEOUT_SECONDS=300
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_EFFORT=low
CODEX_MODEL=gpt-6-luna
CODEX_EFFORT=low
ANTIGRAVITY_MODEL=gemini-3.8-flash-medium
INTAKE_MAX_ATTEMPTS=3
INTAKE_MAX_CONTENT_BYTES=2000000
INTAKE_MAX_PDF_BYTES=25000000
INTAKE_PDF_MAX_PAGES=80
INTAKE_REQUEST_TIMEOUT_SECONDS=20
INTAKE_REQUEST_RETRIES=2
INTAKE_MAX_REDIRECTS=5
INTAKE_RETRY_BASE_SECONDS=30
INTAKE_WORKER_POLL_SECONDS=2
INTAKE_JOB_LEASE_SECONDS=300
BROWSER_RENDER_ENABLED=false
BROWSERLESS_WS_URL=ws://browserless:3000
BROWSERLESS_TOKEN=
BROWSERLESS_CONCURRENT=2
BROWSERLESS_QUEUE_LENGTH=10
BROWSERLESS_TIMEOUT_MS=30000
BROWSER_RENDER_TIMEOUT_SECONDS=20
BROWSER_RENDER_WAIT_MS=500
BROWSER_RENDER_MAX_BYTES=2000000
OCR_ENABLED=false
OCR_COMMAND=tesseract
OCR_LANGUAGES=eng+vie
OCR_DPI=200
OCR_MAX_PIXELS=20000000
OCR_MAX_PAGES=20
OCR_TIMEOUT_SECONDS=30
OCR_MIN_CHARS=40
OCR_MAX_OUTPUT_CHARS=120000
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=/var/lib/research-system/objects
DOCUMENT_MAX_UPLOAD_BYTES=20000000
MINIO_ENDPOINT=minio.example.internal:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true
MINIO_BUCKET=research-documents
MINIO_REGION=
MINIO_AUTO_CREATE_BUCKET=false
MINIO_SPOOL_MEMORY_BYTES=8388608
DOCUMENT_WORKER_MAX_ATTEMPTS=3
DOCUMENT_WORKER_RETRY_BASE_SECONDS=30
DOCUMENT_WORKER_LEASE_SECONDS=600
DOCUMENT_EXTRACT_MAX_CHARS=120000
DOCUMENT_GRAPH_MAX_NODES=80
DOCUMENT_GRAPH_MAX_EDGES=120
LATEX_COMPILER_COMMAND=xelatex
LATEX_COMPILE_TIMEOUT_SECONDS=20
LATEX_COMPILE_MAX_SOURCE_CHARS=200000
LATEX_COMPILE_MAX_PDF_BYTES=10000000
GITHUB_TOKEN=
GRAPH_DATA_PROVIDER=postgres
GRAPH_DEFAULT_NODE_LIMIT=40
GRAPH_MAX_NODE_LIMIT=1000
GRAPH_MAX_EDGE_LIMIT=4000
GRAPH_MAX_DEPTH=2
GRAPH_MAX_NEIGHBORS=20
GRAPH_MAX_PATH_HOPS=12
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_BATCH_SIZE=500
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_RETRY_TIMEOUT_SECONDS=15
NEO4J_HEAP_INITIAL_SIZE=256m
NEO4J_HEAP_MAX_SIZE=512m
NEO4J_PAGECACHE_SIZE=256m
SEARCH_DATA_PROVIDER=postgres
VECTOR_DATA_PROVIDER=postgres
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=
MEILI_MASTER_KEY=
MEILISEARCH_INDEX=research_items
MEILISEARCH_BATCH_SIZE=500
MEILISEARCH_REQUEST_TIMEOUT_SECONDS=10
MEILISEARCH_TASK_TIMEOUT_SECONDS=60
# Embedding: mistral (MISTRAL_API_KEY, mistral-embed) hoặc gemini (GEMINI_API_KEY,
# gemini-embedding-2, có gói miễn phí; gói miễn phí cho Google dùng nội dung để cải thiện sản phẩm).
# Đổi nhà cung cấp/model thì phải lập chỉ mục lại RAG tài liệu và /search/rebuild.
SEARCH_EMBEDDING_PROVIDER=mistral
SEARCH_EMBEDDING_MODEL=mistral-embed
SEARCH_EMBEDDING_DIMENSIONS=1024
SEARCH_EMBEDDING_CHUNK_CHARS=4000
SEARCH_EMBEDDING_MAX_CHUNKS_PER_ITEM=32
SEARCH_EMBEDDING_BATCH_SIZE=32
SEARCH_EMBEDDING_REQUEST_RETRIES=2
SEARCH_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5
SEARCH_DOCUMENT_MAX_CHARS=120000
SEARCH_MAX_RESULTS=100
API_PORT=8000
FRONTEND_PORT=3000
# Địa chỉ nghe trên máy chủ. Mặc định chỉ localhost; điện thoại/đồng đội dùng tunnel hoặc chế độ nhóm.
API_BIND=127.0.0.1
FRONTEND_BIND=127.0.0.1

# --- Discord intake gateway (optional; `docker compose --profile discord up -d discord-bot`) ---
# The gateway refuses to start unless a guild and channel allowlist are both set, so an
# unconfigured deployment cannot quietly collect from every server the bot is invited to.
DISCORD_BOT_TOKEN=
# Scoped service-account token with intake:submit and intake:read-own only.
DISCORD_RESEARCH_API_TOKEN=
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_INTAKE_NAMESPACE=discord
DISCORD_INTAKE_PROVIDER=
# Requests the existing complete-source + confidence-threshold auto-approval path.
DISCORD_AUTO_APPROVE_LINKS=true
DISCORD_LOCALE=vi
DISCORD_USER_RATE_LIMIT=10
DISCORD_POLL_INTERVAL_SECONDS=5
DISCORD_POLL_ATTEMPTS=36

# --- Source politeness and caching ---
# Minimum seconds between two requests to the same host (0 disables the limit).
INTAKE_HOST_MIN_INTERVAL_SECONDS=1.0
# Respect each publisher's robots.txt. Off by default so an upgrade does not silently
# change what an existing deployment collects.
INTAKE_RESPECT_ROBOTS=false
# Send If-None-Match / If-Modified-Since so an unchanged page is not downloaded again.
INTAKE_CONDITIONAL_GET=true
# Request identity. Empty uses a current desktop browser user agent, which publishers
# accept where a crawler identity is refused.
INTAKE_USER_AGENT=
INTAKE_ACCEPT_LANGUAGE=vi,en-US;q=0.9,en;q=0.8
