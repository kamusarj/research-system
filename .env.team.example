# Cấu hình triển khai nhóm. Sao chép thành `.env.team` (đã nằm trong .gitignore) rồi điền giá trị.
# Mọi biến khác trong `.env.example` đều dùng được ở đây; chỉ khai báo khi cần đổi mặc định.
# Xem `Docs/Team Deployment Runbook.md`.

# Dùng chung tên dự án với chế độ cục bộ để giữ nguyên dữ liệu PostgreSQL/tài liệu hiện có.
COMPOSE_PROJECT_NAME=businessaiagents
# Hồ sơ lối vào HTTPS: `https` (Caddy) hoặc `tunnel` (Cloudflare Tunnel). Để trống nếu đã có
# reverse proxy riêng trỏ tới FRONTEND_BIND:FRONTEND_PORT.
COMPOSE_PROFILES=https

# --- Bắt buộc ---
# Địa chỉ thành viên mở trên trình duyệt, luôn là https://.
PUBLIC_URL=https://research.example.com
# Chỉ gồm chữ/số (ví dụ `openssl rand -hex 24`) vì được ghép vào DATABASE_URL.
# Với volume dữ liệu đã có từ chế độ cục bộ, mật khẩu cũ là `research`: đổi bằng
# `make team-db-password` trước khi khởi động (xem runbook).
POSTGRES_PASSWORD=

# --- Lối vào ---
# Caddy: tên miền công khai (tự cấp Let's Encrypt) hoặc IP LAN (chứng chỉ nội bộ của Caddy).
SITE_ADDRESS=research.example.com
HTTP_PORT=80
HTTPS_PORT=443
# Cloudflare Tunnel: token của tunnel, public hostname trỏ tới http://frontend:3000.
CLOUDFLARE_TUNNEL_TOKEN=
# Cổng Next.js trên máy chủ, chỉ nghe nội bộ trừ khi bạn có reverse proxy riêng ở máy khác.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=13000

# --- Nhà cung cấp AI (khóa có thể đặt qua /run/secrets, xem docker-compose.secrets.example.yml) ---
AI_PROVIDER=mistral
MISTRAL_API_KEY=
GRAPH_CHAT_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# --- Mỗi thành viên dùng gói ChatGPT Plus/Pro của chính họ (Sign in with ChatGPT) ---
# Bản chạy trên web cần client ID do OpenAI cấp sau khi duyệt form đối tác
# (https://openai.com/form/sign-in-with-chatgpt-interest/); không có thì để CHATGPT_PLAN_ENABLED=false.
# Callback đăng ký với OpenAI: <PUBLIC_URL>/account/ai/callback
CHATGPT_PLAN_ENABLED=false
CHATGPT_PLAN_CLIENT_ID=
CHATGPT_PLAN_CLIENT_SECRET=
CHATGPT_PLAN_REDIRECT_URI=
# Khóa Fernet mã hóa token của thành viên: `python -m app.operations generate-fernet-key`.
CREDENTIALS_ENCRYPTION_KEY=

# --- Tìm kiếm ngữ nghĩa/RAG cho tài liệu (dùng Mistral embedding) ---
VECTOR_DATA_PROVIDER=pgvector

# --- Dung lượng ---
API_WORKERS=2
AUTH_SESSION_HOURS=12
